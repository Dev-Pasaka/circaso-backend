# What /opt/circaso/.env on the dev server holds. The real file is made once on the server, mode 600, and is never in git or in GitHub.
# It is the same set of settings as .env.example, with these differences for a server:
CIRCASO_ENV=staging                # docs need an ops token; secrets must be real; no dev-only pages
LOG_FORMAT=JSON
REDIS_PASSWORD=                    # any long random string; the app and the Redis container both use it
REDIS_URL=redis://:<REDIS_PASSWORD>@valkey:6379
# PostgreSQL on the data network (no published port). The self-hosted server is reached directly, so both URLs name the same
# address, the app's over R2DBC and the Migrate step's over JDBC.
# The three passwords are the CIRCASO_*_PASSWORD values in postgres.env, which created the roles.
DATABASE_URL=r2dbc:postgresql://postgres:5432/circaso          # the app: R2DBC, non-blocking
DATABASE_MIGRATION_URL=jdbc:postgresql://postgres:5432/circaso  # the Migrate step's Flyway: JDBC
DATABASE_SSL_MODE=disable          # the private data network carries no TLS; anything reached over the internet uses require
DATABASE_PASSWORD=                 # CIRCASO_APP_PASSWORD
DATABASE_JOBS_PASSWORD=            # CIRCASO_JOBS_PASSWORD
DATABASE_MIGRATION_PASSWORD=       # CIRCASO_MIGRATOR_PASSWORD
# Everything else (SCYLLA_*, R2_*, INTEGRATIONS_*, PHONE_HMAC_KEY, IDENTITY_SIGNING_KEY, ...) as in .env.example.
