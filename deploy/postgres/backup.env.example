# What /opt/circaso/backup.env on the dev server holds: the R2 token the nightly database backup (postgres/backup.sh) uploads with.
# Made once on the server, mode 600, never in git. A token of its own (R2 > Manage API tokens > Create, "Object Read & Write" on
# the bucket below only), so the app's keys can't reach the backups and this one can't reach anything else.
R2_ACCOUNT_ID=7dd9928a5b11e9ccd594194153b9ef36
R2_BUCKET=circaso-backend-dev
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=          # the 64-character "Secret Access Key" Cloudflare shows, not the token value
