# What /opt/circaso/postgres.env on the dev server holds: the Postgres and pgAdmin containers' secrets, kept out of .env so the app
# container never sees them. Made once on the server, mode 600, never in git. Values: long random strings (openssl rand -hex 24).
POSTGRES_USER=postgres
POSTGRES_DB=circaso
POSTGRES_PASSWORD=
CIRCASO_READONLY_PASSWORD=              # the role pgAdmin browses with (created on the first start by postgres/initdb)
# The app's login roles (postgres/initdb/20-login-roles.sh). The same three values go in .env as DATABASE_MIGRATION_PASSWORD,
# DATABASE_PASSWORD and DATABASE_JOBS_PASSWORD; the script resets each role's password to these whenever it runs.
CIRCASO_MIGRATOR_PASSWORD=              # circaso_migrator: the Migrate step (schemas, module roles, Flyway)
CIRCASO_APP_PASSWORD=                   # circaso_app: the app pool
CIRCASO_JOBS_PASSWORD=                  # circaso_jobs: the jobs pool
PGADMIN_DEFAULT_EMAIL=                  # pgAdmin's own login, behind Cloudflare Access
PGADMIN_DEFAULT_PASSWORD=
