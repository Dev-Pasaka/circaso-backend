# Copy to `.env` for local development (`cp .env.example .env`). `.env` is not committed. Values here are only read when
# the same variable is not already set in the real environment, so a deploy is never changed by this file.

# ---- environment ------------------------------------------------------------------------------------------------
CIRCASO_ENV=local                 # local | staging | production
# PORT=8080
# HOST=0.0.0.0

# ---- logging ----------------------------------------------------------------------------------------------------
LOG_FORMAT=PRETTY                 # PRETTY (colored, for people) | JSON (staging and production)
LOG_COLOR=true                    # colors under Gradle and IDE run windows too; false to switch them off
# Levels are OFF, ERROR, WARN, INFO, DEBUG or TRACE.
LOG_LEVEL=INFO                    # Circaso's own code, every module
LOG_LEVEL_OTHER=WARN              # libraries and anything not named below
# One service at a time, each overriding LOG_LEVEL for its part (leave a line out to follow LOG_LEVEL):
# LOG_LEVEL_REQUESTS=INFO         the one line per HTTP request
# LOG_LEVEL_GATEWAY=INFO          auth, limits, idempotency, WebSockets, webhooks
# LOG_LEVEL_IDENTITY=INFO
# LOG_LEVEL_USERS=INFO
# LOG_LEVEL_MESSAGING=INFO
# LOG_LEVEL_WALLET=INFO
# LOG_LEVEL_ASSISTANT=INFO
# LOG_LEVEL_INTEGRATIONS=INFO     SMS, email, push and the other vendors
# LOG_LEVEL_CIRCLE=INFO           Circle wallets and its webhook (overrides LOG_LEVEL_INTEGRATIONS for Circle)
# LOG_LEVEL_EXCHANGERATE=INFO     the exchange rates behind fiat balances (overrides LOG_LEVEL_INTEGRATIONS for them)
# LOG_LEVEL_EVENTS=INFO           the outbox relay and the stream consumers
# LOG_LEVEL_SCHEDULER=INFO
LOG_LEVEL_DATABASE=WARN           # PostgreSQL: pools, transactions (slow ones at WARN), migrations; DEBUG shows each transaction
                                  # and its SQL with ? for every value. Exposed's own logger stays at ERROR
LOG_LEVEL_REDIS=WARN              # Redis (Circaso's side and Lettuce's)
LOG_LEVEL_HTTP=ERROR              # the Ktor server and Netty
# Example, to watch sign-in only:  LOG_LEVEL=WARN  LOG_LEVEL_IDENTITY=DEBUG  LOG_LEVEL_REQUESTS=INFO

# ---- databases --------------------------------------------------------------------------------------------------
# PostgreSQL: the compose `postgres` service and the roles its init script creates (deploy/postgres/initdb). The app talks
# R2DBC only (non-blocking), its pools logging in as circaso_app and circaso_jobs; `./gradlew :app:migrate` runs Flyway,
# which is JDBC-only, as circaso_migrator over the direct JDBC URL.
DATABASE_URL=r2dbc:postgresql://localhost:5432/circaso
DATABASE_USER=circaso_app
DATABASE_PASSWORD=circaso_app
DATABASE_JOBS_USER=circaso_jobs
DATABASE_JOBS_PASSWORD=circaso_jobs
DATABASE_MIGRATION_URL=jdbc:postgresql://localhost:5432/circaso   # always a direct connection, never a transaction pooler
DATABASE_MIGRATION_USER=circaso_migrator
DATABASE_MIGRATION_PASSWORD=circaso_migrator
DATABASE_SSL_MODE=disable         # verify-full outside local (the default there); disable only on the sandbox's internal network
# DATABASE_SSL_ROOT_CERT=          # the provider's CA file for verify-full; unset uses the JVM's trust store
# DATABASE_POOL_APP_SIZE=10       # requests and socket frames
# DATABASE_POOL_JOBS_SIZE=3       # outbox relay, event handlers, scheduled jobs
# Pool overrides, in milliseconds (defaults shown):
# DATABASE_POOL_ACQUIRE_TIMEOUT_MS=3000      # no free connection by then: 503 service.unavailable
# DATABASE_POOL_JOBS_ACQUIRE_TIMEOUT_MS=20000 # the jobs pool waits longer, but under the consumers' 30 s reclaim
# DATABASE_POOL_MAX_IDLE_MS=600000
# DATABASE_POOL_MAX_LIFE_MS=1800000
# Behind a transaction pooler that can't keep named prepared statements, add ?preparedStatementCacheQueries=0 to DATABASE_URL.
REDIS_URL=redis://localhost:6379

# ---- outside services: log and fake need nothing; a vendor name needs its credentials -----------------------------
INTEGRATIONS_SMS_PROVIDER=log     # log | fake | africastalking
# Africa's Talking: set INTEGRATIONS_SMS_PROVIDER=africastalking to send the OTP codes and security texts for real. Username 'sandbox' uses their
# test environment (nothing reaches a phone); your app username sends live and costs credit. Without a sender id it uses their shared short code.
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=
# One-time codes: who makes and checks them. none = identity does and SMS_PROVIDER above delivers; twilio = Twilio Verify makes, texts and checks
# the code (see docs/twilio-verify.md). With twilio, INTEGRATIONS_SMS_PROVIDER is no longer used for codes.
INTEGRATIONS_VERIFY_PROVIDER=none   # none | twilio
# TWILIO_ACCOUNT_SID=               # AC... (or an API key's SK... sid)
# TWILIO_AUTH_TOKEN=                # the auth token (or that API key's secret)
# TWILIO_VERIFY_SERVICE_SID=        # VA... from Twilio console > Verify > Services
# TWILIO_VERIFY_LOCALE=             # optional, the text's language, for example en
INTEGRATIONS_EMAIL_PROVIDER=log   # log | fake | resend
# Resend: set the provider to resend once these are filled in. Each template is made in the Resend dashboard (Templates) and
# published; its id goes here. Variables each one receives are listed in docs/email-templates.md.
# RESEND_API_KEY=
# INTEGRATIONS_EMAIL_FROM=Circaso <no-reply@circaso.com>    # a sender on a domain verified in Resend
# INTEGRATIONS_EMAIL_TEMPLATES_NEW_PHONE_SIGN_IN=
# INTEGRATIONS_EMAIL_TEMPLATES_RECOVERY_STARTED=
# INTEGRATIONS_EMAIL_TEMPLATES_RECOVERY_COMPLETED=
# INTEGRATIONS_EMAIL_TEMPLATES_WELCOME=
INTEGRATIONS_SOCIAL_PROVIDER=log  # log | fake | google-apple
# Google and Apple sign-in: set the provider to google-apple once at least one client id below is filled in (see docs/google-apple-signin.md).
INTEGRATIONS_SOCIAL_GOOGLE_CLIENT_IDS=      # paste the Web client id, like 1234-abc.apps.googleusercontent.com; add the Android and iOS ids after it, comma separated, when mobile starts
# INTEGRATIONS_SOCIAL_APPLE_CLIENT_IDS=       # comma separated: the iOS bundle id, and the Services id if Android signs in through the web
# INTEGRATIONS_SOCIAL_APPLE_TEAM_ID=          # only for revoking a grant when an account is deleted
# INTEGRATIONS_SOCIAL_APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=                          # the .p8 text on one line, newlines written as \n
INTEGRATIONS_CARRIER_PROVIDER=log # log | fake | firebase
INTEGRATIONS_PUSH_PROVIDER=log    # log | fake | fcm   (FCM sends to Android and iOS)
# FCM_SERVICE_ACCOUNT=            # Firebase console > Project settings > Service accounts > Generate new private key; the JSON on one line, or base64 of the file
#                                 # iOS also needs the APNs key uploaded once under Project settings > Cloud Messaging
INTEGRATIONS_LLM_PROVIDER=log     # log | fake | workers-ai   (Asha's text model and tool calls)
INTEGRATIONS_VISION_PROVIDER=log  # log | fake | workers-ai   (reading a photo sent to Asha)
INTEGRATIONS_STT_PROVIDER=log     # log | fake | workers-ai   (voice clip to text)
INTEGRATIONS_TTS_PROVIDER=log     # log | fake | workers-ai   (Asha's voice, English only)
INTEGRATIONS_LIVE_STT_PROVIDER=log  # log | fake | workers-ai   (live voice in: Nova-3 over a socket; log/fake read a binary frame of UTF-8 words as speech)
INTEGRATIONS_LIVE_TTS_PROVIDER=log  # log | fake | workers-ai   (live voice out: Aura over a socket, English only)
# Cloudflare Workers AI through AI Gateway: every Asha model, called on api.cloudflare.com/client/v4/accounts/<id>/ai/ with the gateway
# named in a header. Set the six providers above to workers-ai once these three are filled in:
# CLOUDFLARE_ACCOUNT_ID=          # dashboard > Account home > the account's menu > Copy account ID (also on any zone's Overview, right column)
# INTEGRATIONS_AI_GATEWAY=        # dashboard > AI > AI Gateway > Create Gateway; its name goes here (for example circaso-asha). In the gateway's
#                                 # Settings switch Logs OFF: prompts, transcripts and audio must not be kept. Each request also sends
#                                 # cf-aig-collect-log: false, so a log switched back on still skips Asha's calls
# CLOUDFLARE_AI_TOKEN=            # secret. dashboard > My Profile > API Tokens > Create Token > Custom token, permission
#                                 # Account > Workers AI > Read on this account only (an AI Gateway-only token gets 401, code 10000)
# Kimi K2.6 needs paid Workers AI: the Workers Paid plan, or AI Gateway credits with the gateway's Workers AI billing on Unified billing.
# Model ids (developers.cloudflare.com/workers-ai/models/); swapping one is a config change. Defaults shown:
# INTEGRATIONS_AI_MODEL_TEXT=@cf/moonshotai/kimi-k2.6                    # must support function calling
# INTEGRATIONS_AI_MODEL_VOICE_TEXT=                 # live voice turns; default: the text model. Only set a faster model once it is proven to call tools (Llama 4 Scout answered empty, 2026-10-31)
# INTEGRATIONS_AI_MODEL_VISION=@cf/meta/llama-4-scout-17b-16e-instruct
# INTEGRATIONS_AI_MODEL_STT=@cf/openai/whisper-large-v3-turbo           # the one Workers AI model that transcribes Swahili
# INTEGRATIONS_AI_MODEL_TTS=@cf/deepgram/aura-2-en
# INTEGRATIONS_AI_MODEL_LIVE_STT=@cf/deepgram/nova-3                    # live voice in (Opus from the phone); flux needs PCM, ~10x the data
# INTEGRATIONS_AI_MODEL_LIVE_TTS=@cf/deepgram/aura-2-en                 # live voice out (mulaw 8 kHz by default)
# INTEGRATIONS_AI_LIVE_ENDPOINTING_MS=300     # pause after which Nova-3 calls the user's turn over (speech_final)
# INTEGRATIONS_AI_LIVE_UTTERANCE_END_MS=1000  # silence after the last word that also ends the turn (UtteranceEnd; 1000 is the minimum)
# INTEGRATIONS_AI_LIVE_TTS_ENCODING=mulaw     # Aura's live audio to the phone: mulaw (64 kbit/s at 8 kHz) or linear16 (16-bit PCM)
# INTEGRATIONS_AI_LIVE_TTS_SAMPLE_RATE=8000   # 8000 for mulaw; 16000, 24000, 32000 or 48000 for linear16
# INTEGRATIONS_AI_MAX_OUTPUT_TOKENS=8192  # cap on one text-model answer, reasoning included; too low and replies come back empty
#                                         (8192 leaves room for a table and a chart after Kimi's reasoning; 0 is not "no cap")
INTEGRATIONS_CUSTODY_PROVIDER=log # log | fake | circle   (the wallet's Circle user-controlled wallets; log makes up wallets at once)
# Circle (console.circle.com). Set the provider to circle once these are filled in; testnet and mainnet keys are separate.
# CIRCLE_API_KEY=                 # secret. Keys > Create a key > Standard key; TEST_API_KEY:... on testnet
# INTEGRATIONS_CUSTODY_APP_ID=    # Wallets > User Controlled > Configurator > App ID (also GET /v1/w3s/config/entity); handed to the phone's SDK
# Chains and assets (every custody provider reads these; unset, the four testnets below with USDC on each). A wallet can be on
# several chains: it starts on the default one and the user adds others (decision 2026-10-28).
# INTEGRATIONS_CUSTODY_CHAINS=BASE-SEPOLIA,MATIC-AMOY,ETH-SEPOLIA,SOL-DEVNET   # Circle's names; production: BASE,MATIC,ETH,SOL
# INTEGRATIONS_CUSTODY_DEFAULT_CHAIN=BASE-SEPOLIA     # where a new wallet starts; BASE in production
# Per chain (<CHAIN> with - as _): the assets offered there, comma separated, each SYMBOL:tokenAddress:decimals with :usd after a
# US dollar stablecoin (empty tokenAddress for the chain's own coin); USDC addresses from developers.circle.com/stablecoins/usdc-contract-addresses
# INTEGRATIONS_CUSTODY_CHAIN_BASE_SEPOLIA_ASSETS=USDC:0x036CbD53842c5426634e7929541eC2318f3dCF7e:6:usd
# INTEGRATIONS_CUSTODY_CHAIN_MATIC_AMOY_ASSETS=USDC:0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582:6:usd
# INTEGRATIONS_CUSTODY_CHAIN_ETH_SEPOLIA_ASSETS=USDC:0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238:6:usd
# INTEGRATIONS_CUSTODY_CHAIN_SOL_DEVNET_ASSETS=USDC:4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU:6:usd
#   mainnet USDC: BASE 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913, MATIC 0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359,
#   ETH 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48, SOL EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v (a mainnet chain must name its assets)
# INTEGRATIONS_CUSTODY_CHAIN_BASE_SEPOLIA_ACCOUNT_TYPE=SCA   # SCA (default; Gas Station pays the gas) or EOA (the default on Solana)
# Never remove a chain from INTEGRATIONS_CUSTODY_CHAINS while any wallet holds funds on it: retire it instead (decision 2026-10-28).
# A retired chain stays readable and the deletion guard keeps checking it, but no wallet is added there and nobody is paid there.
# INTEGRATIONS_CUSTODY_CHAIN_MATIC_AMOY_RECEIVE_DISABLED=true   # not allowed on the default chain
# Exchange rates for the wallet's fiat balance (USDC = 1 USD): log has a few fixed rates; open-er-api is open.er-api.com (free, no key,
# one table a day, kept in Redis until the next one; the app shows "Rates by Exchange Rate API" where rates appear)
INTEGRATIONS_RATES_PROVIDER=log   # log | fake | open-er-api
# Calls (voice and video) on Cloudflare Realtime's SFU (decision 2026-10-29). log and fake make up sessions and SDP, so the
# call flow runs without media. Set the provider to cloudflare once the app id and token are filled in.
INTEGRATIONS_CALLS_PROVIDER=log   # log | fake | cloudflare
# CLOUDFLARE_REALTIME_APP_ID=       # dashboard > Realtime > Serverless SFU > Create application: its App ID
# CLOUDFLARE_REALTIME_APP_TOKEN=    # secret. The same application's App Secret (Bearer token for rtc.live.cloudflare.com)
# TURN (optional; without it phones get Cloudflare's STUN only, which fails behind some carrier and office NATs):
# CLOUDFLARE_TURN_KEY_ID=           # dashboard > Realtime > TURN Server > Create: its Turn Token ID
# CLOUDFLARE_TURN_KEY_TOKEN=        # secret. That TURN key's API token; credentials are minted for 24 h and cached
# Location message previews (MAP1, decision 2026-10-30): the key never ships in the app; the server draws the picture.
# log answers unavailable and the app keeps its drawn tile. Set google once the key is in.
INTEGRATIONS_MAPS_PROVIDER=log   # log | fake | google
# GOOGLE_MAPS_API_KEY=              # secret. Cloud console > Credentials > API key, restricted to the Maps Static API only
# GOOGLE_MAPS_SIGNING_SECRET=       # secret, recommended. Maps > Credentials > URL signing secret (unsigned requests can then be refused)
# Asha's web search for public facts (decision 2026-10-31; Cloudflare has no web search API). fake (the default) answers two
# made-up results, log none. Set tavily once the key is in.
INTEGRATIONS_SEARCH_PROVIDER=fake   # tavily | log | fake
# TAVILY_API_KEY=                   # secret (tvly-...). app.tavily.com > API Keys; sent as a Bearer token, never logged
# Wallet payment limits in whole USDC (placeholders until limits and KYC are decided)
# WALLET_TRANSFER_LIMIT_PER_PAYMENT=500
# WALLET_TRANSFER_LIMIT_DAILY=1000
# Wallet jobs, the safety net for a lost Circle webhook (wallet.md -> Scheduled jobs). Defaults shown; the doc's StuckTransfers is
# every 5 minutes, the sandbox uses 1. expire-unsigned runs every minute and reconcile-daily once a day (not configurable).
# WALLET_JOBS_STUCK_INTERVAL_SECONDS=60      # how often SUBMITTED transfers are read from Circle
# WALLET_JOBS_STUCK_AFTER_SECONDS=30         # a SUBMITTED transfer at least this old is read
# WALLET_JOBS_STUCK_ALERT_MINUTES=60         # still SUBMITTED this long after it was prepared: a WARN, once
# WALLET_JOBS_TRANSFER_BATCH=50              # transfers per run, for both transfer jobs
# WALLET_JOBS_RECONCILE_INTERVAL_SECONDS=120 # the light pass over active wallets
# WALLET_JOBS_ACTIVE_WINDOW_MINUTES=30       # active = a W1 read, a W3 session or a payment within this window
# WALLET_JOBS_ACTIVE_LOOKBACK_MINUTES=60     # the light pass reads Circle's transactions created this far back
# WALLET_JOBS_ACTIVE_BATCH=50                # users per light pass
# WALLET_JOBS_DAILY_BATCH=1000               # users per daily pass
# WALLET_JOBS_TRANSACTIONS_PER_USER=100      # Circle transactions read per user per pass
# Webhooks: in the console add the notification URL https://<host>/v1/hooks/circle for transactions.inbound and transactions.outbound
# GATEWAY_WEBHOOKS_CIRCLE_ALLOWED_IPS=   # optional: Circle's published webhook source IPs, comma separated; unset, any address may call
# MESSAGING_FRAME_CIPHERTEXT_MAX_CHARS=16384  # a message.new frame carries ciphertext up to this many base64 characters; longer ones are fetched from the inbox
STORAGE_PROVIDER=local            # local | r2   (switch to r2 once R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY below are set)
# Cloudflare R2 (the AWS SDK for Kotlin, S3 compatible). The app's files go in a PRIVATE bucket (no public address), reached only with
# the keys below. Logos and email images live in the public circaso-static bucket (assets.circaso.com), which the app does not touch.
# STORAGE_R2_ACCOUNT_ID=7dd9928a5b11e9ccd594194153b9ef36
# STORAGE_BUCKET=circaso-backend-dev
# R2_ACCESS_KEY_ID=               # R2 > Manage API tokens > Create, "Object Read & Write" on circaso-backend-dev only
# R2_SECRET_ACCESS_KEY=          # the 64-character "Secret Access Key" Cloudflare shows (the SHA-256 of the token value), not the token value itself

# ---- identity ----------------------------------------------------------------------------------------------------------
# How long a deleted account stays recoverable; then identity.complete-deletions deletes its data and publishes
# identity.AccountDeleted, and every module deletes that user's data (decision 2026-10-27)
IDENTITY_DELETION_GRACE_DAYS=30

# ---- assistant (Asha) ------------------------------------------------------------------------------------------------
# Lifts Asha's daily text turns, voice seconds and context length for everyone, whatever their plan (decision
# 2026-10-31). For testing only: off unless set to true.
# ASSISTANT_LIMITS_UNLIMITED=false
# Each plan's numbers (the defaults are placeholders until the allowance is decided):
# ASSISTANT_FREE_TEXT_TURNS_PER_DAY=20
# ASSISTANT_FREE_VOICE_SECONDS_PER_DAY=120
# ASSISTANT_FREE_CONTEXT_MESSAGES=6
# ASSISTANT_PLUS_TEXT_TURNS_PER_DAY=300
# ASSISTANT_PLUS_VOICE_SECONDS_PER_DAY=1800
# ASSISTANT_PLUS_CONTEXT_MESSAGES=60
# ASSISTANT_MAX_TOOL_STEPS=10      # model calls in one turn (each tool call is one more)
# ASSISTANT_AGENT_BASE_URL=http://localhost:8080   # where Asha's tools reach the /v1/agent/ routes (this server)
# Asha's voices (decision 2026-10-31): replaces the whole list, id:Name:Character:gender entries, comma-separated; the
# id is the voice provider's speaker (Aura 2 on Workers AI). Unset: Luna, Harmonia, Thalia, Arcas, Orion, Zeus.
# ASSISTANT_VOICES=luna:Luna:Friendly:female,harmonia:Harmonia:Calm:female,thalia:Thalia:Bright:female,arcas:Arcas:Warm:male,orion:Orion:Gentle:male,zeus:Zeus:Steady:male
# ASSISTANT_DEFAULT_VOICE=luna     # the voice used when the app sends none (default: luna, or the list's first)

# ---- secrets (a stable set so tokens survive a restart; generate your own for anything shared) ------------------------
# PHONE_HMAC_KEY=                 shared by identity and users; any long random string
# ASSISTANT_VAULT_KEY=            any long random string
# IDENTITY_SIGNING_KEY=           Ed25519 private key, PKCS#8 DER, base64:  openssl genpkey -algorithm ed25519 -outform DER | base64
# IDENTITY_SIGNING_PUBLIC_KEY=    its raw 32-byte public key, base64url
