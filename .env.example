# Copy to `.env` for local development (`cp .env.example .env`). `.env` is not committed. Values here are only read when
# the same variable is not already set in the real environment, so a deploy is never changed by this file.

# ---- environment ------------------------------------------------------------------------------------------------
CIRCASO_ENV=local                 # local | staging | production
# PORT=8080
# HOST=0.0.0.0

# ---- logging ----------------------------------------------------------------------------------------------------
LOG_FORMAT=PRETTY                 # PRETTY (colored, for people) | JSON (staging and production)
LOG_COLOR=true                    # colors under Gradle and IDE run windows too; false to switch them off
# Levels are OFF, ERROR, WARN, INFO, DEBUG or TRACE.
LOG_LEVEL=INFO                    # Circaso's own code, every module
LOG_LEVEL_OTHER=WARN              # libraries and anything not named below
# One service at a time, each overriding LOG_LEVEL for its part (leave a line out to follow LOG_LEVEL):
# LOG_LEVEL_REQUESTS=INFO         the one line per HTTP request
# LOG_LEVEL_GATEWAY=INFO          auth, limits, idempotency, WebSockets, webhooks
# LOG_LEVEL_IDENTITY=INFO
# LOG_LEVEL_USERS=INFO
# LOG_LEVEL_MESSAGING=INFO
# LOG_LEVEL_ASSISTANT=INFO
# LOG_LEVEL_INTEGRATIONS=INFO     SMS, email, push and the other vendors
# LOG_LEVEL_EVENTS=INFO           the outbox relay and the stream consumers
# LOG_LEVEL_SCHEDULER=INFO
LOG_LEVEL_DATABASE=ERROR          # ScyllaDB and Kandra (Circaso's side and the driver's); WARN shows local-only notices
LOG_LEVEL_REDIS=WARN              # Redis (Circaso's side and Lettuce's)
LOG_LEVEL_HTTP=ERROR              # the Ktor server and Netty
# Example, to watch sign-in only:  LOG_LEVEL=WARN  LOG_LEVEL_IDENTITY=DEBUG  LOG_LEVEL_REQUESTS=INFO

# ---- databases --------------------------------------------------------------------------------------------------
SCYLLA_CONTACT_POINTS=localhost:9042
SCYLLA_DATACENTER=datacenter1
# SCYLLA_TLS=false                # on by default outside local
# SCYLLA_CREATE_SCHEMA=true       # create keyspaces and tables on start: on only for a node on this machine; a remote cluster is migrated with :app:migrate
# SCYLLA_KEYSPACE_REPLICATION_CLASS=SimpleStrategy   # for keyspaces :app:migrate creates when missing: SimpleStrategy (default locally) | NetworkTopologyStrategy (default elsewhere, in SCYLLA_DATACENTER)
# SCYLLA_KEYSPACE_REPLICATION_FACTOR=1
# SCYLLA_KEYSPACE_TABLETS=false   # tablets for a keyspace migrate creates; off, like the sandbox's keyspaces. An existing keyspace is never altered
# SCYLLA_USERNAME=
# SCYLLA_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---- outside services: log and fake need nothing; a vendor name needs its credentials -----------------------------
INTEGRATIONS_SMS_PROVIDER=log     # log | fake | africastalking
# Africa's Talking: set INTEGRATIONS_SMS_PROVIDER=africastalking to send the OTP codes and security texts for real. Username 'sandbox' uses their
# test environment (nothing reaches a phone); your app username sends live and costs credit. Without a sender id it uses their shared short code.
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=
# One-time codes: who makes and checks them. none = identity does and SMS_PROVIDER above delivers; twilio = Twilio Verify makes, texts and checks
# the code (see docs/twilio-verify.md). With twilio, INTEGRATIONS_SMS_PROVIDER is no longer used for codes.
INTEGRATIONS_VERIFY_PROVIDER=none   # none | twilio
# TWILIO_ACCOUNT_SID=               # AC... (or an API key's SK... sid)
# TWILIO_AUTH_TOKEN=                # the auth token (or that API key's secret)
# TWILIO_VERIFY_SERVICE_SID=        # VA... from Twilio console > Verify > Services
# TWILIO_VERIFY_LOCALE=             # optional, the text's language, for example en
INTEGRATIONS_EMAIL_PROVIDER=log   # log | fake | resend
# Resend: set the provider to resend once these are filled in. Each template is made in the Resend dashboard (Templates) and
# published; its id goes here. Variables each one receives are listed in docs/email-templates.md.
# RESEND_API_KEY=
# INTEGRATIONS_EMAIL_FROM=Circaso <no-reply@circaso.com>    # a sender on a domain verified in Resend
# INTEGRATIONS_EMAIL_TEMPLATES_NEW_PHONE_SIGN_IN=
# INTEGRATIONS_EMAIL_TEMPLATES_RECOVERY_STARTED=
# INTEGRATIONS_EMAIL_TEMPLATES_RECOVERY_COMPLETED=
# INTEGRATIONS_EMAIL_TEMPLATES_WELCOME=
INTEGRATIONS_SOCIAL_PROVIDER=log  # log | fake | google-apple
# Google and Apple sign-in: set the provider to google-apple once at least one client id below is filled in (see docs/google-apple-signin.md).
INTEGRATIONS_SOCIAL_GOOGLE_CLIENT_IDS=      # paste the Web client id, like 1234-abc.apps.googleusercontent.com; add the Android and iOS ids after it, comma separated, when mobile starts
# INTEGRATIONS_SOCIAL_APPLE_CLIENT_IDS=       # comma separated: the iOS bundle id, and the Services id if Android signs in through the web
# INTEGRATIONS_SOCIAL_APPLE_TEAM_ID=          # only for revoking a grant when an account is deleted
# INTEGRATIONS_SOCIAL_APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=                          # the .p8 text on one line, newlines written as \n
INTEGRATIONS_CARRIER_PROVIDER=log # log | fake | firebase
INTEGRATIONS_PUSH_PROVIDER=log    # log | fake | fcm   (FCM sends to Android and iOS)
# FCM_SERVICE_ACCOUNT=            # Firebase console > Project settings > Service accounts > Generate new private key; the JSON on one line, or base64 of the file
#                                 # iOS also needs the APNs key uploaded once under Project settings > Cloud Messaging
INTEGRATIONS_LLM_PROVIDER=log     # log | fake | workers-ai   (Asha's model)
INTEGRATIONS_STT_PROVIDER=log
INTEGRATIONS_TTS_PROVIDER=log
STORAGE_PROVIDER=local            # local | r2   (switch to r2 once R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY below are set)
# Cloudflare R2 (the AWS SDK for Kotlin, S3 compatible). The app's files go in a PRIVATE bucket (no public address), reached only with
# the keys below. Logos and email images live in the public circaso-static bucket (assets.circaso.com), which the app does not touch.
# STORAGE_R2_ACCOUNT_ID=7dd9928a5b11e9ccd594194153b9ef36
# STORAGE_BUCKET=circaso-backend-dev
# R2_ACCESS_KEY_ID=               # R2 > Manage API tokens > Create, "Object Read & Write" on circaso-backend-dev only
# R2_SECRET_ACCESS_KEY=          # the 64-character "Secret Access Key" Cloudflare shows (the SHA-256 of the token value), not the token value itself

# ---- secrets (a stable set so tokens survive a restart; generate your own for anything shared) ------------------------
# PHONE_HMAC_KEY=                 shared by identity and users; any long random string
# ASSISTANT_VAULT_KEY=            any long random string
# IDENTITY_SIGNING_KEY=           Ed25519 private key, PKCS#8 DER, base64:  openssl genpkey -algorithm ed25519 -outform DER | base64
# IDENTITY_SIGNING_PUBLIC_KEY=    its raw 32-byte public key, base64url
